  "options": {
    "step": {
      "init": {
        "title": "Telekom Speedport Smart options",
        "description": "Supported entities and controls are enabled by default. Missing router capabilities are omitted; temporary read failures show affected entities as unavailable. Controls run only after a deliberate user action. Polling below router refresh cadence adds load without improving accuracy.",
        "data": {
          "enable_controls": "Show supported router controls",
          "fast_interval": "Fast polling interval",
          "normal_interval": "Normal polling interval",
          "slow_interval": "Slow polling interval"
        },
        "data_description": {
          "enable_controls": "Show only implemented controls supported by this router. They remain idle until you explicitly use them and never run automatically.",
          "fast_interval": "Seconds between WAN counter and live-state updates (1–60). One second is best-effort; 5 seconds is recommended for router reliability.",
          "normal_interval": "Seconds between status, Wi-Fi, client and telephony updates.",
          "slow_interval": "Seconds between configuration, topology and firmware updates."
        }
      }
    }
