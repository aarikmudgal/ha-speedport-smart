{
  "title": "Telekom Speedport Smart",
  "config": {
    "step": {
      "user": {
        "title": "Connect to Telekom Speedport Smart",
        "description": "Connect directly to your router. Before continuing, use **Logout** in any open Speedport web interface; closing only the tab or window may leave its session active.",
        "data": {
          "host": "Host",
          "password": "Router password",
          "use_https": "Use HTTPS",
          "verify_ssl": "Verify TLS certificate"
        },
        "data_description": {
          "host": "Router hostname or IP address, usually speedport.ip.",
          "password": "Required for protected read-only router data. The password stays in Home Assistant.",
          "use_https": "Use encrypted router and ToTR64 endpoints.",
          "verify_ssl": "Enable only when the router certificate is trusted by Home Assistant."
        }
      },
      "reauth_confirm": {
        "title": "Reauthenticate Telekom Speedport Smart",
        "description": "Enter the current router password.",
        "data": {
          "password": "Router password"
        }
      },
      "reconfigure": {
        "title": "Reconfigure Telekom Speedport Smart",
        "description": "Update the local router connection settings.",
        "data": {
          "host": "Host",
          "password": "Router password",
          "use_https": "Use HTTPS",
          "verify_ssl": "Verify TLS certificate"
        },
        "data_description": {
          "host": "Router hostname or IP address.",
          "password": "Leave unchanged to keep the current password.",
          "use_https": "Use encrypted router and ToTR64 endpoints.",
          "verify_ssl": "Enable only when the router certificate is trusted by Home Assistant."
        }
      }
    },
    "error": {
      "cannot_connect": "Unable to connect to the router.",
      "invalid_auth": "The router rejected the credentials.",
      "router_busy": "Another router management session is active. Use **Logout** in the Speedport web interface, then retry; closing only the tab or window may leave the session active.",
      "unknown": "Unexpected error. Check the Home Assistant log."
    },
    "abort": {
      "already_configured": "This router is already configured.",
      "reauth_successful": "Reauthentication completed.",
      "reconfigure_successful": "Router configuration updated.",
      "wrong_account": "The detected router does not match this configuration entry."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Telekom Speedport Smart options",
        "description": "Supported entities and controls are enabled by default. Missing router capabilities are omitted; temporary read failures show affected entities as unavailable. Controls run only after a deliberate user action. Polling below router refresh cadence adds load without improving accuracy.",
        "data": {
          "enable_controls": "Show supported router controls",
          "fast_interval": "Fast polling interval",
          "wan_interval": "Advanced WAN counter interval",
          "normal_interval": "Normal polling interval",
          "slow_interval": "Slow polling interval"
        },
        "data_description": {
          "enable_controls": "Show only implemented controls supported by this router. They remain idle until you explicitly use them and never run automatically.",
          "fast_interval": "Seconds between browser-independent live-state updates (1–60). This does not control router-sensitive WAN counters.",
          "wan_interval": "Use 0 for automatic learning: counters start at 5 seconds and safely test 4, 3, 2 and 1 second after stable reads. Set 1–60 only to choose an advanced target; transient busy responses still back off automatically.",
          "normal_interval": "Seconds between status, Wi-Fi, client and telephony updates.",
          "slow_interval": "Seconds between configuration, topology and firmware updates."
        }
      }
    }
  },
  "exceptions": {
    "controls_disabled": {
      "message": "Router controls are disabled in the Telekom Speedport Smart integration options."
    },
    "command_unsupported": {
      "message": "This router does not support the requested action."
    },
    "command_failed": {
      "message": "The router could not complete the requested action. Check the Home Assistant log before trying again."
    },
    "command_verification_failed": {
      "message": "The router action was sent, but its resulting state could not be verified. Check the router state before trying again."
    }
  },
