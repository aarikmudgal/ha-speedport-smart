  "issues": {
    "management_session_blocked": {
      "title": "A Speedport web session is blocking protected router data",
      "fix_flow": {
        "step": {
          "init": {
            "title": "Log out of the Speedport web interface",
            "description": "Before continuing, use the **Logout** action in the Speedport web interface. Closing the browser tab or window may leave the management session active. After you have logged out, select **Submit** to retry by reloading Telekom Speedport Smart. This does not force the browser session to disconnect."
          }
        }
