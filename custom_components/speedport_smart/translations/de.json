  "options": {
    "step": {
      "init": {
        "title": "Optionen für Telekom Speedport Smart",
        "description": "Unterstützte Entitäten und Steuerelemente sind standardmäßig aktiviert. Nicht vorhandene Router-Funktionen werden ausgelassen. Bei vorübergehenden Lesefehlern sind die betroffenen Entitäten nicht verfügbar. Steuerelemente werden nur nach einer bewussten Benutzeraktion ausgeführt. Ein Abfrageintervall unterhalb des Aktualisierungstakts des Routers erhöht die Last, ohne die Genauigkeit zu verbessern.",
        "data": {
          "enable_controls": "Unterstützte Router-Steuerelemente anzeigen",
          "fast_interval": "Schnelles Abfrageintervall",
          "wan_interval": "Erweitertes Intervall der WAN-Zähler",
          "normal_interval": "Normales Abfrageintervall",
          "slow_interval": "Langsames Abfrageintervall"
        },
        "data_description": {
          "enable_controls": "Nur implementierte Steuerelemente anzeigen, die dieser Router unterstützt. Sie bleiben inaktiv, bis du sie ausdrücklich verwendest, und werden nie automatisch ausgeführt.",
          "fast_interval": "Sekunden zwischen browserunabhängigen Live-Status-Aktualisierungen (1–60). Dies steuert nicht die routerempfindlichen WAN-Zähler.",
          "wan_interval": "0 aktiviert automatisches Lernen: Die Zähler starten mit 5 Sekunden und testen nach stabilen Abfragen sicher 4, 3, 2 und 1 Sekunde. 1–60 setzt nur für Fortgeschrittene einen Zielwert; vorübergehende Belegt-Antworten lösen weiterhin automatisch einen Backoff aus.",
          "normal_interval": "Sekunden zwischen Aktualisierungen von Status, WLAN, Geräten und Telefonie.",
          "slow_interval": "Sekunden zwischen Aktualisierungen von Konfiguration, Topologie und Firmware."
        }
      }
    }
  },
  "exceptions": {
    "controls_disabled": {
      "message": "Router-Steuerelemente sind in den Optionen der Integration Telekom Speedport Smart deaktiviert."
    },
    "command_unsupported": {
      "message": "Dieser Router unterstützt die angeforderte Aktion nicht."
    },
    "command_failed": {
      "message": "Der Router konnte die angeforderte Aktion nicht ausführen. Prüfe das Home-Assistant-Protokoll, bevor du es erneut versuchst."
    },
    "command_verification_failed": {
      "message": "Die Router-Aktion wurde gesendet, ihr Ergebniszustand konnte jedoch nicht bestätigt werden. Prüfe den Router-Zustand, bevor du es erneut versuchst."
    }
  },
