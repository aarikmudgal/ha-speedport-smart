  "config": {
    "step": {
      "user": {
        "title": "Mit Telekom Speedport Smart verbinden",
        "description": "Stelle eine direkte Verbindung zu deinem Router her. Verwende vorher **Abmelden** in jeder geöffneten Speedport-Weboberfläche. Wenn du nur den Tab oder das Fenster schließt, kann die Sitzung aktiv bleiben.",
        "data": {
          "host": "Host",
          "password": "Router-Passwort",
          "use_https": "HTTPS verwenden",
          "verify_ssl": "TLS-Zertifikat prüfen"
        },
        "data_description": {
          "host": "Hostname oder IP-Adresse des Routers, normalerweise speedport.ip.",
          "password": "Für geschützte Router-Daten mit Lesezugriff erforderlich. Das Passwort bleibt in Home Assistant.",
          "use_https": "Verschlüsselte Router- und ToTR64-Endpunkte verwenden.",
          "verify_ssl": "Nur aktivieren, wenn Home Assistant dem Router-Zertifikat vertraut."
        }
      },
      "reauth_confirm": {
        "title": "Telekom Speedport Smart erneut authentifizieren",
        "description": "Gib das aktuelle Router-Passwort ein.",
